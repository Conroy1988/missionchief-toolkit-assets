  "legacyPanelSources": {
    "map": ["tools"],
    "missions": ["resources", "ops"],
    "alliance": ["alliance"],
    "dispatch": ["dispatch"],
    "finance": ["discord", "payouts"],
    "locations": ["places"],
    "appearance": ["skins"],
    "settings": ["settings"]
  },
  "legacyStateMigration": {
    "skins": "appearance",
    "tools": "map",
    "resources": "missions",
    "ops": "missions",
    "payouts": "finance",
    "discord": "finance",
    "places": "locations",
    "fleet": "missions",
    "allianceAdmin": "alliance"
  },
  "placements": {
    "map": [
      "makeToggleButton('allianceBuildingsMapBlocker'",
      "makeToggleButton('transportWatcher'",
      "makeToggleButton('unitCommitment'",
      "makeToggleButton('missionAge'"
    ],
    "missions": [
      "makeToggleButton('resourceGap'",
      "makeToggleButton('autoLoadAllVehicles'",
      "makeToggleButton('majorIncidentFeed'",
      "makeToggleButton('missionLockAudio'",
      "data-action=\"open-vehicle-status\""
    ],
    "alliance": [
      "data-action=\"scan-alliance-courses\"",
      "data-action=\"scan-transport-sweep\"",
      "data-setting=\"alliance-course-duration\"",
      "data-alliance-courses"
    ],
    "dispatch": [
      "data-action=\"load-dispatch-recruitment\"",
      "data-action=\"scan-dispatch-recruitment\"",
      "data-action=\"apply-dispatch-recruitment\"",
      "data-setting=\"dispatch-recruitment-building-type\"",
      "data-setting=\"dispatch-recruitment-centre\"",
      "data-setting=\"dispatch-recruitment-hiring-phase\"",
      "data-setting=\"dispatch-recruitment-personnel\"",
      "data-dispatch-recruitment"
    ],
    "finance": [
      "makeToggleButton('payoutFlash'",
      "data-action=\"test-payout-flash\"",
      "data-setting=\"discord-webhook\"",
      "data-action=\"finance-archive-scan\""
    ],
    "locations": [
      "mcms-quick-list",
      "mcms-bookmark-list",
      "data-profile-list"
    ],
    "appearance": [
      "mcms-ui-theme-grid",
      "${coreThemeButtons}",
      "${serviceThemeButtons}"
    ],
    "settings": [
      "makeToggleButton('shortcuts'",
      "data-device-layout-status",
      "data-action=\"export-config\"",
      "makeActionToggleButton('toggle-command-bar'"
    ]
  },
  "singlePlacementTokens": [
    "makeToggleButton('allianceBuildingsMapBlocker'",
    "makeToggleButton('autoLoadAllVehicles'",
    "makeToggleButton('majorIncidentFeed'",
    "makeToggleButton('missionLockAudio'",
    "makeToggleButton('transportWatcher'",
    "makeToggleButton('unitCommitment'",
    "makeToggleButton('missionAge'",
    "data-action=\"scan-alliance-courses\"",
    "data-action=\"scan-transport-sweep\"",
    "data-action=\"scan-dispatch-recruitment\"",
    "data-action=\"apply-dispatch-recruitment\"",
    "data-profile-list"
  ],
  "themes": [
    "Map Command",
    "Cyberpunk",
    "Fallout 4",
    "Umbrella",
    "Factorio",
    "007 Intelligence",
    "Hyrule Command",
    "The Godfather"
