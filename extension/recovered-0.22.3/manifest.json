{
  "manifest_version": 3,
  "name": "MissionChief Map Command Toolkit",
  "version": "0.22.3",
  "version_name": "UI Test Candidate \u00b7 Extension 0.22.3 \u00b7 Toolkit 10.18.1",
  "description": "Map controls, mission insights and administration tools for MissionChief UK. Independent community extension. Early Access.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://missionchief.co.uk/*",
    "https://*.missionchief.co.uk/*",
    "https://raw.githubusercontent.com/*",
    "https://tkb-gaming.scot/*",
    "https://leitstellenspiel.s3.amazonaws.com/*",
    "https://discord.com/api/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Map Command Toolkit",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://missionchief.co.uk/*",
        "https://*.missionchief.co.uk/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "toolkit.css",
        "workspace.css",
        "operations.css",
        "compatibility-probe.css",
        "command-ui.css", "finance-dashboard.css", "surface-theme.css"
      ],
      "matches": [
        "https://missionchief.co.uk/*",
        "https://*.missionchief.co.uk/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
