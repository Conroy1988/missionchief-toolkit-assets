{
  "schemaVersion": 1,
  "workflow": ".github/workflows/recover-development-package.yml",
  "triggers": [
    "manual owner workflow_dispatch",
    "connector-authenticated push command"
  ],
  "commandTransport": {
    "branch": "automation/development-packages",
    "path": ".github/automation-commands/recover-development-package.json",
    "actor": "Conroy1988",
    "changedFiles": 1,
    "exactMainHead": true,
    "exactPullRequestHead": true,
    "nonceRequired": true
  },
  "acceptedPullRequest": {
    "state": "open",
    "base": "main",
    "owner": "Conroy1988",
    "sameRepository": true,
    "changedFiles": 1,
    "pathPattern": ".github/development-packages/*.py"
  },
  "publication": {
    "target": "existing pull-request branch",
    "credential": "DEVELOPMENT_PR_TOKEN",
    "exactHeadLease": true,
    "publicMainAllowed": false
  },
  "requiredValidation": [
    "canonical userscript validation",
    "JavaScript syntax",
    "source and distribution parity"
  ]
}
